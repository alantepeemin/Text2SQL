# ── Text2SQL ortam değişkenleri ─────────────────────────────────────────────
# Kullanım:  cp .env.example .env   → değerleri doldurun → docker compose up -d
#
# docker-compose.yml dosyasını DÜZENLEMEYİN; tüm değerler buradan okunur.
#   ${DEGISKEN:?...}  → ZORUNLU, verilmezse compose başlamaz
#   ${DEGISKEN:-...}  → opsiyonel, verilmezse varsayılan kullanılır
#
# .env dosyasını ASLA commit etmeyin (.gitignore kapsamındadır).

# ── ZORUNLU ─────────────────────────────────────────────────────────────────

# JWT imzalama anahtarı — en az 32 karakter, üretimde 64+ önerilir.
# Üretmek için:  openssl rand -base64 48
JWT_SECRET_KEY=en-az-32-karakterlik-guclu-bir-anahtar-uretin

# OpenRouter API anahtarı
OPENROUTER_API_KEY=sk-or-...

# PostgreSQL parolası.
# DİKKAT: Bu değer yalnızca veritabanı hacmi İLK oluşturulurken uygulanır.
# Sonradan değiştirirseniz mevcut hacim eski parolayla kalır ve bağlantı
# "password authentication failed" verir. Boş bir kurulumda hacmi sıfırlayın:
#   docker compose down -v
POSTGRES_PASSWORD=guclu-bir-db-sifresi

# ── OPSİYONEL (varsayılanları vardır) ───────────────────────────────────────

# Ön yüzün adresi (CORS). Birden fazla adres gerekiyorsa docker-compose.yml
# içinde Cors__AllowedOrigins__1, __2 ... satırları ekleyin.
CORS_ORIGIN=http://localhost:3001

# LLM modeli. Sağlayıcı kataloğundaki TAM slug olmalı; yanlış değer sorguların
# "AI servisi hata döndürdü: 404" ile başarısız olmasına yol açar.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ── ÜRETİMDE ŞİDDETLE ÖNERİLİR ──────────────────────────────────────────────
# DataProtection anahtar şifrelemesi. Ayarlanmazsa anahtarlar şifresiz saklanır
# ve veritabanı yedeği sızarsa müşterilerin uzak DB bağlantı dizeleri açılabilir.
# (Yol boşsa veya dosya yoksa uygulama açılır, yalnızca başlangıçta uyarır.)
#
# Sertifika üretimi:
#   openssl req -x509 -newkey rsa:2048 -keyout dp.key -out dp.crt -days 3650 -nodes -subj "/CN=text2sql-dp"
#   openssl pkcs12 -export -out dp.pfx -inkey dp.key -in dp.crt -passout pass:GUCLU_PAROLA
#
# DATAPROTECTION_CERT_PATH=/run/secrets/dp.pfx
# DATAPROTECTION_CERT_PASSWORD=GUCLU_PAROLA
