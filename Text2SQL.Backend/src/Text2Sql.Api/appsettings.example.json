{
  "_aciklama": "Bu dosya ŞABLONDUR. 'cp appsettings.example.json appsettings.json' ile kopyalayın. SIRLARI BU DOSYAYA YAZMAYIN — user-secrets veya ortam değişkeni kullanın.",

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=text2sql;Username=text2sql;Password=SET_VIA_USER_SECRETS"
  },

  "JwtSettings": {
    "SecretKey": "SET_VIA_USER_SECRETS",
    "Issuer": "Text2SQL.API",
    "Audience": "Text2SQL.Client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "OpenRouter": {
    "ApiKey": "SET_VIA_USER_SECRETS",
    "BaseUrl": "https://openrouter.ai/api/v1/",
    "Model": "anthropic/claude-haiku-4.5"
  },

  "Query": {
    "MaxRows": 1000,
    "TimeoutSeconds": 30,
    "JobTimeoutSeconds": 180,
    "SqlCacheEnabled": true
  },

  "Usage": {
    "TokensPerQueryAllowance": 3000,
    "Pricing": {
      "default":                     { "InputPer1M": 1.00, "OutputPer1M": 5.00 },
      "anthropic/claude-haiku-4.5":  { "InputPer1M": 1.00, "OutputPer1M": 5.00 },
      "anthropic/claude-sonnet-4.5": { "InputPer1M": 3.00, "OutputPer1M": 15.00 }
    }
  },

  "RateLimiting": {
    "AuthPerMinute": 10,
    "QueryPerMinute": 30
  },

  "Storage": {
    "SqliteRoot": "App_Data/sqlite",
    "ResultsRoot": "App_Data/results"
  },

  "Retention": {
    "Enabled": false,
    "RunEveryHours": 24,
    "BatchSize": 5000,
    "QueryHistoryDays": 0,
    "UsageRecordDays": 0,
    "AuditLogDays": 0
  },

  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": ""
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3001" ]
  },

  "Email": {
    "Enabled": false,
    "InvitationBaseUrl": "http://localhost:3001",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseStartTls": true,
      "Username": "",
      "Password": "SET_VIA_USER_SECRETS",
      "FromAddress": "no-reply@example.com",
      "FromName": "Text2SQL"
    }
  },

  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": ""
  },

  "Logging": {
    "LogUserQuestions": false,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "AllowedHosts": "*"
}
