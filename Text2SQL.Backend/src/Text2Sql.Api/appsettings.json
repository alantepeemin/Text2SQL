{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=text2sql;Username=text2sql;Password=CHANGE_ME_OR_USE_USER_SECRETS"
  },

  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_SECRET_FROM_ENV_OR_USER_SECRETS",
    "Issuer": "Text2SQL.API",
    "Audience": "Text2SQL.Client",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },

  "Storage": {
    "SqliteRoot": "Data/SQLite",
    "ResultsRoot": "Data/Results"
  },

  "Email": {
    "Enabled": false,
    "InvitationBaseUrl": "http://localhost:3001",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "REPLACE_WITH_SECRET_FROM_ENV_OR_KEY_VAULT",
      "FromAddress": "",
      "FromName": "Text2SQL",
      "UseStartTls": true
    }
  },

  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigin": "http://localhost:3001"
  },

  "OpenRouter": {
    "ApiKey": "REPLACE_WITH_OPENROUTER_API_KEY",
    "Model": "anthropic/claude-3.5-sonnet",
    "TimeoutSeconds": 60
  },

  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": "http://localhost:4317"
  },

  "Usage": {
    "TokensPerQueryAllowance": 3000,
    "Pricing": {
      "default":             { "InputPer1M": 0.40, "OutputPer1M": 1.60 },
      "openai/gpt-4.1-mini": { "InputPer1M": 0.40, "OutputPer1M": 1.60 }
    }
  },

  "Retention": {
    "Enabled": true,
    "RunEveryHours": 24,
    "QueryHistoryDays": 90,
    "UsageRecordDays": 400,
    "AuditLogDays": 365,
    "BatchSize": 5000
  },

  "Query": {
    "MaxRows": 1000,
    "TimeoutSeconds": 30,
    "SqlCacheEnabled": true
  },

  "RateLimiting": {
    "AuthPerMinute": 10,
    "QueryPerMinute": 30
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}